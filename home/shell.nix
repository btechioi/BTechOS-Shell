# shell.nix by poligle

{ config, osConfig, pkgs, lib, ... }:
let
	btechos = osConfig.btechos;
	t = btechos.tokens;
	quickshell = pkgs.quickshell;
	profile = "${config.home.profileDirectory}/bin";
	iconTheme = config.gtk.iconTheme.name;
	# The calendars subscribed to in Preferences, read into what the shell shows (home/calendar).
	calendar = import ./calendar { inherit pkgs; };

	nilo =
	{
		enabled = btechos.nilo.enable;
		agent = lib.optionalString btechos.nilo.enable "${import ./nilo { inherit pkgs lib osConfig; inherit (commands) terminal; }}/bin/nilo-agent";
	};

	deck =
	{
		enabled = btechos.deck.enable;
		command = "${profile}/btechos-deck";
		inherit (btechos.deck) port;
	};

	# The desktop's widgets; Preferences shows each by its text, cfgWidgetClock for clock. Only
	# the first ones are on until Preferences says otherwise.
	widgets = [ "clock" "calendar" "network" "system" "media" "weather" "photo" "note" "github" ];
	widgetDefaults = [ "clock" "media" ];
	unlabelled = lib.filter (name: !(btechos.strings ? ${"cfgWidget" + lib.toUpper (lib.substring 0 1 name) + lib.substring 1 (lib.stringLength name) name}))
		widgets;

	qml = import ../theme/qml.nix { inherit pkgs lib btechos; };
	tokensQml = qml.tokens;

	cavaConfig = pkgs.writeText "btechos-cava.conf" (lib.generators.toINI { }
	{
		general = { bars = 24; framerate = 30; autosens = 1; };
		input = { method = "pipewire"; source = "auto"; };
		output =
		{
			method = "raw";
			raw_target = "/dev/stdout";
			data_format = "ascii";
			ascii_max_range = 6;
			bar_delimiter = 59;
			frame_delimiter = 10;
		};
		smoothing.noise_reduction = 70;
	});

	commands =
	{
		sh = "${pkgs.bash}/bin/sh";
		ffmpeg = "${pkgs.ffmpeg-headless}/bin/ffmpeg";
		curl = "${pkgs.curl}/bin/curl";
		df = "${pkgs.coreutils}/bin/df";
		calendar = "${calendar}/bin/btechos-calendar";
		nmcli = "${pkgs.networkmanager}/bin/nmcli";
		nmEditor = "${pkgs.networkmanagerapplet}/bin/nm-connection-editor";
		notifySend = "${pkgs.libnotify}/bin/notify-send";
		brightnessctl = "${pkgs.brightnessctl}/bin/brightnessctl";
		pwPlay = "${pkgs.pipewire}/bin/pw-play";
		rfkill = "${pkgs.util-linux}/bin/rfkill";
		hyprsunset = "${pkgs.hyprsunset}/bin/hyprsunset";
		ip = "${pkgs.iproute2}/bin/ip";
		cava = "${pkgs.cava}/bin/cava";
		qalc = "${pkgs.libqalculate}/bin/qalc";
		wlCopy = "${pkgs.wl-clipboard}/bin/wl-copy";
		systemctl = "${pkgs.systemd}/bin/systemctl";
		uwsm = "${osConfig.programs.uwsm.package}/bin/uwsm";
		xdgOpen = "${pkgs.xdg-utils}/bin/xdg-open";
		pavucontrol = "${pkgs.pavucontrol}/bin/pavucontrol";
		blueman = "${pkgs.blueman}/bin/blueman-manager";
		terminal = "${profile}/kitty";
		watch = "${profile}/btechos-watch";
		editor = "${profile}/nvim";
		lock = "${profile}/lock-screen";
		powerOff = "${profile}/power-off";
		micLedSync = "${profile}/mic-led-sync";
		wallpaper = "${profile}/btechos-wallpaper";
		clipboard = "${profile}/btechos-clipboard";
		record = "${profile}/btechos-record";
		shot = "${profile}/btechos-shot";
		xdgUserDir = "${pkgs.xdg-user-dirs}/bin/xdg-user-dir";
		hyprctl = "${osConfig.programs.hyprland.package}/bin/hyprctl";
		hyprkvm = "/run/current-system/sw/bin/hyprkvm";
		hyprkvmCtl = "/run/current-system/sw/bin/hyprkvm-ctl";
		sudo = "/run/wrappers/bin/sudo";
		btechos = "/run/current-system/sw/bin/btechos";
		timedatectl = "${pkgs.systemd}/bin/timedatectl";
	};

	sounds =
	{
		menu = "${btechos.sounds.menu}";
		notify = "${btechos.sounds.notify}";
		critical = "${btechos.sounds.critical}";
		charge = "${btechos.sounds.charge}";
	};

	# Every keyboard layout and its variants, from the xkb data the system uses: Region offers and
	# checks only what exists.
	xkbLayouts = pkgs.runCommand "xkb-layouts.json" { } ''
		${pkgs.gawk}/bin/awk '
			/^! / { section = $2; next }
			section == "layout" && NF { layouts[$1] = 1 }
			section == "variant" && NF { l = $2; sub(":", "", l); v[l] = v[l] (v[l] == "" ? "" : ",") "\"" $1 "\"" }
			END { printf "{"; n = 0; for (l in layouts) printf "%s\"%s\":[%s]", (n++ ? "," : ""), l, v[l]; print "}" }
		' ${osConfig.services.xserver.xkb.dir}/rules/base.lst > $out
	'';

	configQml = pkgs.writeText "Config.qml" ''
		pragma Singleton

		import Quickshell

		// Generated by home/shell.nix from the host outputs (modules/btechos.nix).
		Singleton {
		    readonly property var barOutputs: ${builtins.toJSON (builtins.attrNames (lib.filterAttrs (_: output: output.bar) btechos.outputs))}
		    readonly property string primaryOutput: "${btechos.primaryOutput}"
		    readonly property int persistentWorkspaces: 3
		    readonly property var widgets: ${builtins.toJSON widgets}
		    readonly property var widgetDefaults: ${builtins.toJSON widgetDefaults}
		    readonly property var trayHidden: ${builtins.toJSON btechos.trayHidden}
		    readonly property var wallpapers: ${builtins.toJSON btechos.wallpapers.names}
		    readonly property int clipboard: ${toString btechos.clipboard}
		    readonly property string cavaConfig: "${cavaConfig}"
		    readonly property string xkbLayouts: "${xkbLayouts}"
		    readonly property var sounds: (${builtins.toJSON sounds})
		    readonly property var cmd: (${builtins.toJSON commands})
		    readonly property var nilo: (${builtins.toJSON nilo})
		    readonly property var deck: (${builtins.toJSON deck})

		    readonly property string settingsFile: "${btechos.flake}/settings.json"
		    readonly property string wallpaperDir: "${btechos.wallpapers}"
		    readonly property string user: "${btechos.user.name}"
		    readonly property string greeting: ${builtins.toJSON btechos.user.greeting}
		    readonly property var binds: (${builtins.toJSON btechos.binds})
		    readonly property var bindDefaults: (${builtins.toJSON btechos.bindDefaults.keys})
		    readonly property var gestureDefaults: (${builtins.toJSON btechos.bindDefaults.gestures})
		    readonly property var gestures: (${builtins.toJSON btechos.gestures})
		    readonly property var programs: (${builtins.toJSON btechos.programs})
		}
	'';

	langQml = qml.lang;

	shaders = import ../theme/shaders.nix { inherit pkgs; };

	shell = pkgs.runCommand "btechos-shell" { } ''
		cp -r ${./shell} $out
		chmod -R u+w $out
		cp ${shaders}/*.qsb $out/shaders/
		mkdir -p $out/config
		cp ${tokensQml} $out/theme/Tokens.qml
		cp ${configQml} $out/config/Config.qml
		cp ${langQml} $out/config/Lang.qml
		substituteInPlace $out/shell.qml --replace-fail "@ICON_THEME@" "${iconTheme}"
	'';

	btechos-ipc = pkgs.writeShellScriptBin "btechos-ipc" ''
		exec ${quickshell}/bin/qs -c btechos ipc call "$@"
	'';
in
{
	home.packages =
	[
		quickshell
		btechos-ipc
		calendar
	];

	xdg.configFile."quickshell/btechos".source = shell;

	assertions =
	[
		{
			assertion = unlabelled == [ ];
			message = "theme/i18n.nix: every desktop widget in home/shell.nix needs its cfgWidget text; ${lib.concatStringsSep ", " unlabelled} hasn't one.";
		}
	];

	systemd.user.services.btechos-shell =
	{
		Unit =
		{
			Description = "BTechOS shell (Quickshell)";
			After = [ "graphical-session.target" ];
			PartOf = [ "graphical-session.target" ];
			X-Restart-Triggers = [ "${shell}" ];
		};

		Service =
		{
			ExecStart = "${quickshell}/bin/qs -c btechos";
			Restart = "on-failure";
			RestartSec = 2;
			# Apps start in scopes of their own (Apps.run); this keeps the small helpers it leaves
			# behind, like wl-copy holding what was copied, through a restart of the shell.
			KillMode = "process";
			Environment = lib.mapAttrsToList (name: value: "${name}=${value}") (import ./session-env.nix);
		};

		Install.WantedBy = [ "graphical-session.target" ];
	};
}
