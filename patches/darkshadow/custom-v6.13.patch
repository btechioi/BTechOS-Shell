+        (row(active), row(inactive), row(disabled)))
+    put(qdir + "/qt6ct.conf", "[Appearance]\nstyle=Fusion\nstandard_dialogs=xdgdesktopportal\ncustom_palette=true\ncolor_scheme_path=%s\n" % scheme)
+
+
+ZED_THEME = "DarkShadow Dynamic"
+
+
+def zed_theme(p):
+    """Zed: a local theme family using the same palette; select it in settings.json."""
+    s = lambda k: p[k].lower()
+    mixc = lambda a, b, t: mix(p[a], b, t)
+    style = {
+        "background": s("surface"), "background.appearance": "opaque",
+        "surface.background": s("surface_container"), "elevated_surface.background": s("surface_high"),
+        "border": s("outline_variant"), "border.variant": s("outline"), "border.focused": s("primary"),
+        "border.selected": s("primary"), "border.transparent": "#00000000", "border.disabled": s("outline_variant"),
+        "element.background": s("surface_high"), "element.hover": mixc("surface_high", "#ffffff", 0.10),
+        "element.active": s("primary"), "element.selected": s("secondary_container"),
+        "element.disabled": s("surface_container"), "text": s("on_surface"),
+        "text.muted": s("on_surface_variant"), "text.placeholder": s("outline"), "text.accent": s("primary"),
+        "icon": s("on_surface"), "icon.muted": s("on_surface_variant"),
+        "status_bar.background": s("surface_low"), "title_bar.background": s("surface"),
+        "toolbar.background": s("surface"), "tab_bar.background": s("surface_low"),
+        "tab.inactive_background": s("surface_low"), "tab.active_background": s("surface"),
+        "panel.background": s("surface_low"), "search.match_background": s("secondary_container"),
+        "editor.background": s("surface"), "editor.foreground": s("on_surface"),
+        "editor.gutter.background": s("surface"), "editor.line_number": s("outline"),
+        "editor.active_line_number": s("on_surface"),
+        "editor.active_line.background": mix(p["surface"], p["primary"], 0.10),
+        "editor.selection.background": s("secondary_container"), "editor.subheader.background": s("surface_container"),
+        "terminal.background": s("surface"), "terminal.foreground": s("on_surface"),
+        "syntax": {
+            "keyword": {"color": s("primary")}, "string": {"color": s("tertiary")},
+            "comment": {"color": s("outline")}, "function": {"color": s("secondary")},
+            "type": {"color": s("primary_container")}, "variable": {"color": s("on_surface")},
+            "constant": {"color": s("tertiary")}, "punctuation": {"color": s("on_surface_variant")},
+            "tag": {"color": s("primary")},
+        },
+    }
+    family = {"$schema": "https://zed.dev/schema/themes/v0.2.0.json", "name": ZED_THEME,
+              "author": "DarkShadowShell",
+              "themes": [{"name": ZED_THEME, "appearance": "dark", "style": style}]}
+    put(XDG + "/zed/themes/darkshadow.json", json.dumps(family, indent=2) + "\n")
+    # keep the user's other settings; only the theme name changes
+    settings = XDG + "/zed/settings.json"
+    try:
+        text = open(settings).read()
+    except OSError:
+        text = ""
+    if '"%s"' % ZED_THEME in text:
+        return
+    if re.search(r'"theme"\s*:\s*"[^"]*"', text):
+        text = re.sub(r'"theme"\s*:\s*"[^"]*"', '"theme": "%s"' % ZED_THEME, text, count=1)
+    elif text.strip().startswith("{"):
+        text = re.sub(r"\{", '{\n  "theme": "%s",' % ZED_THEME, text, count=1)
+    else:
+        text = '{\n  "theme": "%s"\n}\n' % ZED_THEME
+    put(settings, text)
+
+
 def sync():
     c = load()
     p = palette()
+    qt_theme(p)
+    zed_theme(p)
     a = c["apps"]
     v, bad = vscode(a.get("vscode", True), p) if vscode_files() else ([], [])
     d = discord(a.get("discord", True), p) if discord_dirs() else []
