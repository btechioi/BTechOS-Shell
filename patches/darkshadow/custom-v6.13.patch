diff --git a/quickshell/rice-desktop/MediaPick.qml b/quickshell/rice-desktop/MediaPick.qml
new file mode 100644
index 0000000..4d041e3
--- /dev/null
+++ b/quickshell/rice-desktop/MediaPick.qml
@@ -0,0 +1,43 @@
+pragma Singleton
+import Quickshell
+import Quickshell.Services.Mpris
+import QtQuick
+
+// Prefer the Plasma Browser Integration MPRIS bridge when it is playing: it
+// carries media-session titles, artwork, duration and seek support from the
+// browser extension. A normal playing player still wins over an idle bridge.
+Singleton {
+    id: mediaPick
+
+    function isPlasmaBridge(p) {
+        if (!p) return false
+        const s = (String(p.dbusName || "") + " " + String(p.identity || "") + " " + String(p.desktopEntry || "")).toLowerCase()
+        return s.indexOf("plasma-browser-integration") >= 0
+    }
+
+    function rank(p) {
+        if (!p) return -1
+        if (p.isPlaying) return isPlasmaBridge(p) ? 3 : 2
+        return isPlasmaBridge(p) ? 1 : 0
+    }
+
+    // fallback=true keeps the old "show the first player even when paused"
+    // behaviour for panels such as the dock and the music widget.
+    function pick(fallback) {
+        const l = Mpris.players.values
+        let best = null
+        let bestRank = -1
+        let first = null
+        for (let i = 0; i < l.length; i++) {
+            const p = l[i]
+            if (!first) first = p
+            const r = rank(p)
+            if (r > bestRank) {
+                best = p
+                bestRank = r
+            }
+        }
+        if (bestRank > 0) return best
+        return fallback ? first : null
+    }
+}
