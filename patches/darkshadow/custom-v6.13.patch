+def portal_read(path):
+    try:
+        out(json.load(open(path)))
+    except Exception as e:
+        out({"ok": False, "error": str(e)})
+
+
+def portal_response(path, val):
+    try:
+        j = json.loads(val)
+    except Exception:
+        out({"ok": False})
+        return
+    # Files passes the request descriptor path. The portal backend polls the
+    # matching .response.json file, so never overwrite the descriptor itself.
+    if path.endswith(".response.json"):
+        dest = path
+    elif path.endswith(".json"):
+        dest = path[:-5] + ".response.json"
+    else:
+        dest = path + ".response.json"
+    d = os.path.dirname(dest)
+    if d:
+        os.makedirs(d, exist_ok=True)
+    with open(dest + ".tmp", "w") as f:
+        json.dump(j, f)
+    os.replace(dest + ".tmp", dest)
+    out({"ok": True})
+
+
