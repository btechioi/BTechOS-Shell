@@ -139,10 +139,25 @@
 
 NV = shutil.which("nvidia-smi")
 DRM = [p for p in glob.glob("/sys/class/drm/card*/device/gpu_busy_percent")]
+# Intel i915 does not publish gpu_busy_percent on every kernel. Its GT frequency
+# tracks load closely enough for the shell's GPU widgets, so fall back to that.
+IGT = (glob.glob("/sys/class/drm/card*/gt/gt0/rps_cur_freq_mhz")
+       + glob.glob("/sys/class/drm/card*/gt_cur_freq_mhz"))
+
+
+def intel_busy():
+    for cur in IGT:
+        d = os.path.dirname(cur)
+        c = read(cur)
+        lo = read(os.path.join(d, "rps_min_freq_mhz")) or read(os.path.join(d, "gt_min_freq_mhz"))
+        hi = read(os.path.join(d, "rps_max_freq_mhz")) or read(os.path.join(d, "gt_max_freq_mhz"))
+        if all(str(x).isdigit() for x in (c, lo, hi)) and int(hi) > int(lo):
+            return round((int(c) - int(lo)) / (int(hi) - int(lo)) * 100)
+    return 0
 
 
