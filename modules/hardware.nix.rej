diff a/modules/hardware.nix b/modules/hardware.nix	(rejected hunks)
@@ -42,16 +42,84 @@ in
     };
     services.fprintd.enable = config.nihil.fingerprint;
 
+    # Secret Service provider for apps that store credentials (Zed's GitHub
+    # login, browsers, ...). Without it they cannot persist tokens and ask
+    # to sign in again on every launch.
+    services.gnome.gnome-keyring.enable = true;
+
     hardware.enableRedistributableFirmware = lib.mkDefault true;
     boot.kernelPackages = lib.mkDefault pkgs.linuxPackages_latest;
     security.pam.services = lib.genAttrs [ "sudo" "su" "login" "polkit-1" "greetd" ] skipFingerprint //
     {
         hyprlock.fprintAuth = false;
+        greetd.enableGnomeKeyring = true;
     };
     zramSwap.enable = true;
+
+    # Preserve the Wayland session env so `sudo nvim` (and other GUI/TUI tools
+    # run as root) can reach the user's clipboard and Wayland socket.
+    security.sudo.extraConfig = ''
+        Defaults env_keep += "WAYLAND_DISPLAY XDG_RUNTIME_DIR"
+    '';
+
+    # --- Performance: universal (all systems) ---
+    # Memory tuning
+    boot.kernel.sysctl = {
+        "vm.swappiness" = 10;
+        "vm.vfs_cache_pressure" = 50;
+        "vm.dirty_ratio" = 10;
+        "vm.dirty_background_ratio" = 5;
+    };
+
+    # Nix store auto-optimisation
+    nix.settings.auto-optimise-store = true;
+
+    # I/O scheduler: none for NVMe/SSD (set in udev rules above)
+
+    # Smart power management: performance on AC, powersave on battery
+    services.tlp = {
+        enable = true;
+        settings = {
+            CPU_SCALING_GOVERNOR_ON_AC = "performance";
+            CPU_SCALING_GOVERNOR_ON_BAT = "powersave";
+            CPU_ENERGY_PERF_POLICY_ON_AC = "performance";
+            CPU_ENERGY_PERF_POLICY_ON_BAT = "power";
+        } // lib.optionalAttrs (config.nihil.gpu == "intel" || config.nihil.gpu == "auto") {
+            INTEL_GPU_MIN_FREQ_ON_AC = 0;
+            INTEL_GPU_MAX_FREQ_ON_AC = 0;
+        };
+    };
+
     hardware.graphics.enable = true;
+
+    # --- Intel-specific (Kaby Lake: i5-7440HQ + HD 630) ---
+    boot.kernelParams = lib.optionals (config.nihil.gpu == "intel" || config.nihil.gpu == "auto") [
+        "i915.enable_guc=3"
+        "i915.enable_fbc=1"
+        "i915.enable_psr=1"
+        "intel_pstate=active"
+    ];
+
+    services.thermald.enable = lib.mkDefault (config.nihil.gpu == "intel" || config.nihil.gpu == "auto");
+
+    # Intel VA-API drivers
+    hardware.graphics.extraPackages = lib.optionals (config.nihil.gpu == "intel" || config.nihil.gpu == "auto") (with pkgs; [
+        intel-media-driver
+        intel-vaapi-driver
+        libva-vdpau-driver
+        vpl-gpu-rt
+    ]);
+    hardware.graphics.extraPackages32 = lib.optionals (config.nihil.gpu == "intel" || config.nihil.gpu == "auto") (with pkgs; [
+        intel-media-driver
+        intel-vaapi-driver
+    ]);
     
     services.udev.extraRules = ''
         ACTION=="add", SUBSYSTEM=="leds", KERNEL=="platform::micmute", RUN+="${pkgs.coreutils}/bin/chgrp nihil-leds /sys/class/leds/%k/brightness", RUN+="${pkgs.coreutils}/bin/chmod g+w /sys/class/leds/%k/brightness"
+
+        # SSDs/NVMe: none (multi-queue, no seek penalty)
+        ACTION=="add|change", KERNEL=="sd[a-z]*|nvme[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"
+        # HDDs: mq-deadline (better for rotational media)
+        ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="mq-deadline"
     '';
 }
